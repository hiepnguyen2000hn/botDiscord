DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_client_id
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# CLIProxyAPI (see docs/cliproxyapi-setup.md)
PROXY_API_URL=http://127.0.0.1:8317
PROXY_API_KEY=your_cliproxyapi_key

# DeepSeek fallback, used automatically when the proxy above is unreachable
DEEPSEEK_API_KEY=your_deepseek_api_key

# Article extraction fallbacks (scriptwriter command), both optional.
# Jina AI Reader works without a key (JINA_API_KEY only raises its rate limit).
JINA_API_KEY=your_jina_api_key
SCRAPINGBEE_API_KEY=your_scrapingbee_api_key
