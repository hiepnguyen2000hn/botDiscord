[Unit]
Description=CLIProxyAPI (AI proxy backing the Discord bot /chat command)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cliproxyapi
Group=cliproxyapi
WorkingDirectory=/opt/botDiscord/cliproxyapi
ExecStart=/opt/botDiscord/cliproxyapi/cli-proxy-api --config /opt/botDiscord/cliproxyapi/config.yaml --no-browser
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
